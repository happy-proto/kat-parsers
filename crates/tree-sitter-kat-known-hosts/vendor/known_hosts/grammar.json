{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "known_hosts",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_line"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_space"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_space"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "entry"
                },
                {
                  "type": "SYMBOL",
                  "name": "comment_line"
                }
              ]
            }
          ]
        }
      ]
    },
    "entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "marker",
                  "content": {
                    "type": "SYMBOL",
                    "name": "marker"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "_space"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "hosts",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "host_list"
              },
              {
                "type": "SYMBOL",
                "name": "hashed_host"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_space"
        },
        {
          "type": "FIELD",
          "name": "key_type",
          "content": {
            "type": "SYMBOL",
            "name": "key_type"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_space"
        },
        {
          "type": "FIELD",
          "name": "key_blob",
          "content": {
            "type": "SYMBOL",
            "name": "key_blob"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_space"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "FIELD",
                      "name": "comment",
                      "content": {
                        "type": "SYMBOL",
                        "name": "entry_comment"
                      }
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "marker": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "cert_authority"
        },
        {
          "type": "SYMBOL",
          "name": "revoked"
        }
      ]
    },
    "cert_authority": {
      "type": "STRING",
      "value": "@cert-authority"
    },
    "revoked": {
      "type": "STRING",
      "value": "@revoked"
    },
    "host_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "host_pattern"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "host_pattern"
              }
            ]
          }
        }
      ]
    },
    "host_pattern": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "!"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "hostname"
        }
      ]
    },
    "hostname": {
      "type": "PATTERN",
      "value": "[^ \\t\\r\\n,!|#@]+"
    },
    "hashed_host": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "|1|"
        },
        {
          "type": "FIELD",
          "name": "salt",
          "content": {
            "type": "SYMBOL",
            "name": "hash_salt"
          }
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "FIELD",
          "name": "hash",
          "content": {
            "type": "SYMBOL",
            "name": "host_hash"
          }
        }
      ]
    },
    "hash_salt": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9+/]+={0,2}"
    },
    "host_hash": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9+/]+={0,2}"
    },
    "key_type": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9][A-Za-z0-9@._+-]*"
    },
    "key_blob": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9+/]+={0,2}"
    },
    "entry_comment": {
      "type": "PATTERN",
      "value": "[^ \\t\\r\\n][^\\r\\n]*"
    },
    "comment_line": {
      "type": "PATTERN",
      "value": "#[^\\r\\n]*"
    },
    "_space": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}