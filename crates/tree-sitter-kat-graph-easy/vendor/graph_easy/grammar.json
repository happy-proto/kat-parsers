{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "graph_easy",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "chain"
        },
        {
          "type": "SYMBOL",
          "name": "defaults"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "chain": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "node_list"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "edge"
                },
                {
                  "type": "SYMBOL",
                  "name": "node_list"
                }
              ]
            }
          }
        ]
      }
    },
    "node_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_endpoint"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "_endpoint"
              }
            ]
          }
        }
      ]
    },
    "_endpoint": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "node"
        },
        {
          "type": "SYMBOL",
          "name": "bare_node"
        },
        {
          "type": "SYMBOL",
          "name": "group"
        }
      ]
    },
    "node": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "node_label"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attributes"
          }
        }
      ]
    },
    "node_label": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "node_text"
          },
          {
            "type": "SYMBOL",
            "name": "escape_sequence"
          }
        ]
      }
    },
    "node_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\]\\\\]+"
        }
      }
    },
    "escape_sequence": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\\\[^\\r\\n]"
      }
    },
    "bare_node": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attributes"
          }
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[^\\s\\[\\]{}()<>;,=:~#.-]+"
    },
    "group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "group_name"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_statement"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attributes"
          }
        }
      ]
    },
    "group_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\s\\[\\]{}()#][^\\[\\]{}()\\r\\n]*"
        }
      }
    },
    "edge": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "edge_operator"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "edge_label"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "edge_operator"
                      }
                    ]
                  },
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "attributes"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "edge_operator"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "attributes"
            }
          }
        ]
      }
    },
    "edge_operator": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "<?[-=.~#]+>?"
      }
    },
    "edge_label": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s\\[\\]{}()<>\\r\\n=~#.-][^\\[\\]{}()<>\\r\\n=~#.-]*"
      }
    },
    "defaults": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "class_name"
        },
        {
          "type": "SYMBOL",
          "name": "attributes"
        }
      ]
    },
    "class_name": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "graph"
              },
              {
                "type": "STRING",
                "value": "node"
              },
              {
                "type": "STRING",
                "value": "edge"
              },
              {
                "type": "STRING",
                "value": "group"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "\\.[a-zA-Z_][a-zA-Z0-9_-]*"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "attributes": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute_name"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "attribute_value"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ";"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "attribute_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_-]*"
    },
    "attribute_value": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "value_text"
          },
          {
            "type": "SYMBOL",
            "name": "quoted_value"
          },
          {
            "type": "SYMBOL",
            "name": "escape_sequence"
          }
        ]
      }
    },
    "value_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^;{}\"\\\\\\r\\n]+"
        }
      }
    },
    "quoted_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\"\\\\]+"
                }
              },
              {
                "type": "SYMBOL",
                "name": "escape_sequence"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#[^#\\r\\n][^\\r\\n]*|#"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}